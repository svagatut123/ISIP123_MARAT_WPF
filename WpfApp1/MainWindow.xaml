<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfApp1 - Roguelike" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid x:Name="GameScreen" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ROGUELIKE" FontSize="36" 
                       HorizontalAlignment="Center" Margin="10"/>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="FloorText" Text="уровень: 0" FontSize="16"/>
                    <TextBlock x:Name="EquipText" Text="" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="HealthText" Text="HP: 100/100" FontSize="16"/>
                    <ProgressBar x:Name="HealthBar" Width="200" Height="20" 
                                 Maximum="100" Value="100" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#F5F5F5">
                        <TextBlock x:Name="EnemyDisplay" Text="" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChestDisplay" Text="СУНДУК" FontSize="48"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                HorizontalAlignment="Center" Margin="10">
                        <Button x:Name="AttackBtn" Content="Атака" Width="100" Height="40" 
                                Margin="5" Click="AttackBtn_Click"/>
                        <Button x:Name="DefendBtn" Content="Защита" Width="100" Height="40" 
                                Margin="5" Click="DefendBtn_Click"/>
                        <Button x:Name="TakeBtn" Content="Взять" Width="100" Height="40" 
                                Margin="5" Click="TakeBtn_Click" Visibility="Collapsed"/>
                        <Button x:Name="DropBtn" Content="Выбросить" Width="100" Height="40" 
                                Margin="5" Click="DropBtn_Click" Visibility="Collapsed"/>
                        <Button x:Name="StartBtn" Content="Начать игру" Width="150" Height="40" 
                                Margin="5" Click="StartBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="5">
                    <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Text="Нажмите 'Начать игру'" FontSize="12" 
                                   TextWrapping="Wrap" Margin="10"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5">
                    <StackPanel Margin="10">
                        <TextBlock Text="Предмет в сундуке:" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ItemInfo" Text="" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="GameOverScreen" Visibility="Collapsed" Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Background="White">
                <TextBlock Text="ВЫ ПОГИБЛИ" FontSize="36" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock x:Name="FinalFloor" Text="Достигнут уровень: 0" FontSize="18" 
                           Margin="0,0,0,30"/>
                <Button Content="Начать заново" Width="200" Height="50" FontSize="18"
                        Click="RestartButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>