<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button x:Name="CatalogButton" Click="CatalogButton_Click" Margin="5" Height="80" ToolTip="каталог книг">
                <Image Source="Images/catalog.png" Stretch="Uniform"/>
            </Button>

            <Button x:Name="ListsButton" Click="ListsButton_Click" Margin="5" Height="80" ToolTip="списки книг">
                <Image Source="Images/lists.png" Stretch="Uniform"/>
            </Button>

            <Button x:Name="AuthorButton" Click="AuthorButton_Click" Margin="5" Height="80" ToolTip="страница автора" Visibility="Collapsed">
                <Image Source="Images/author.png" Stretch="Uniform"/>
            </Button>

            <Button x:Name="AdminButton" Click="AdminButton_Click" Margin="5" Height="80" ToolTip="администрирование" Visibility="Collapsed">
                <Image Source="Images/admin.png" Stretch="Uniform"/>
            </Button>

            <Button x:Name="ProfileButton" Click="ProfileButton_Click" Margin="5" Height="80" ToolTip="профиль">
                <Image Source="Images/profile.png" Stretch="Uniform"/>
            </Button>

            <Button x:Name="WarningButton" Margin="5" Height="80" ToolTip="аккаунт заморожен!" Visibility="Collapsed" Background="Red">
                <Image Source="Images/warning.png" Stretch="Uniform"/>
            </Button>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>