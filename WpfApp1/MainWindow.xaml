<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfApp1 - Roguelike" Height="750" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid x:Name="StartScreen" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Images/Rogalik.jpg" Width="150" Height="150" 
                       Margin="0,0,0,20"/>

                <TextBlock Text="Рогалик" FontSize="48" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Пошаговая игра с генерацией уровней" 
                           FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="Начать игру" Width="200" Height="50" FontSize="18"
                        Click="StartButton_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="GameScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Рогалик" FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="10"/>

            <Grid Grid.Row="1" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Image Source="Images/player.jpg" Width="40" Height="40" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FloorText" Text="Этаж: 1" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="EquipText" Text="" FontSize="13" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="HealthText" Text="HP: 100/100" FontSize="16" FontWeight="Bold"/>
                    <ProgressBar x:Name="HealthBar" Width="200" Height="20" 
                                 Maximum="100" Value="100" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#F0F0F0">
                        <Image x:Name="EnemyImage" 
                           Width="200" Height="200"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Stretch="Uniform"/>

                                        <Image x:Name="ChestImage" Source="Images/chest.jpg" 
                           Width="180" Height="180"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Stretch="Uniform"/>

                                    <TextBlock x:Name="EnemyText" Text="" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock x:Name="EnemyHpText" Text="" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,10" FontWeight="Bold"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                HorizontalAlignment="Center" Margin="10">
                        <Button x:Name="AttackBtn" Content="Атака" Width="100" Height="40" 
                                Margin="5" Click="AttackBtn_Click"/>
                        <Button x:Name="DefendBtn" Content="Защита" Width="100" Height="40" 
                                Margin="5" Click="DefendBtn_Click"/>
                        <Button x:Name="TakeBtn" Content="Взять" Width="100" Height="40" 
                                Margin="5" Click="TakeBtn_Click" Visibility="Collapsed"/>
                        <Button x:Name="DropBtn" Content="Выбросить" Width="100" Height="40" 
                                Margin="5" Click="DropBtn_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="5">
                    <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Text="" FontSize="12" 
                                   TextWrapping="Wrap" Margin="10"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5">
                    <StackPanel Margin="10">
                        <TextBlock Text="Предмет:" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ItemInfo" Text="—" FontSize="12" 
                                   Margin="0,5,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="GameOverScreen" Visibility="Collapsed" Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Background="White">
                <Image Source="Images/skull.jpg" Width="120" Height="120" 
                       Margin="0,0,0,20"/>

                <TextBlock Text="ВЫ ПОГИБЛИ" FontSize="36" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="Red"/>
                <TextBlock x:Name="FinalFloor" Text="Достигнут этаж: 1" FontSize="18" 
                           Margin="0,0,0,30"/>
                <Button Content="Начать заново" Width="200" Height="50" FontSize="18"
                        Click="RestartButton_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>