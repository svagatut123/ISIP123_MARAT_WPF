<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="BtnPage1" Content="товары" Width="100" Height="50" Margin="10" Click="BtnPage1_Click"></Button>
                <Button x:Name="BtnPage2" Content="корзина" Width="100" Height="50" Margin="10" Click="BtnPage2_Click"></Button>
                <Button x:Name="BtnPage3" Content="заказы" Width="100" Height="50" Margin="10" Click="BtnPage3_Click"></Button>
            </StackPanel>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid> 
</Window>
