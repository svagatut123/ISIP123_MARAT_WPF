<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="кинотеатр" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="LightGray">
            <TextBox x:Name="SearchBox" Width="200" Margin="10,0,0,0" TextChanged="SearchBox_TextChanged" 
                     VerticalContentAlignment="Center" Padding="5"/>
            <ComboBox x:Name="SortComboBox" Width="150" Margin="10,0,0,0" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="название а-я"/>
                <ComboBoxItem Content="название я-а"/>
                <ComboBoxItem Content="рейтинг убыв"/>
                <ComboBoxItem Content="рейтинг возраст"/>
            </ComboBox>
            <Button x:Name="AccountButton" Content="войти" Width="120" Margin="10,0,0,0" Click="AccountButton_Click"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>