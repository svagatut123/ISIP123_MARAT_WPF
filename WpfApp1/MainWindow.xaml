<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="12 практика!" Height="600" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="10">
            <StackPanel>
                <ProgressBar x:Name="AppProgressBar" Height="8" 
                             Minimum="0" Maximum="100" Value="20"/>
                <TextBlock x:Name="StepTitle" Text="Шаг 1: Выбор модели" 
                           HorizontalAlignment="Center" Margin="0,5"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" 
               Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>