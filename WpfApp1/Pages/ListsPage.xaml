<Page x:Class="WpfApp1.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="Мои списки" FontSize="18" Margin="0,0,0,10"/>
        <ComboBox x:Name="CmbListStatus" SelectionChanged="CmbListStatus_SelectionChanged" Width="150" Margin="0,0,0,10">
            <ComboBoxItem Content="Заброшено"/>
            <ComboBoxItem Content="В планах"/>
            <ComboBoxItem Content="Читаю"/>
            <ComboBoxItem Content="Прочитано"/>
        </ComboBox>
        <DataGrid x:Name="GridMyBooks" AutoGenerateColumns="True" />
    </StackPanel>
</Page>