<Page x:Class="WpfApp1.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация нового пользователя"
      Background="White">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <StackPanel>
            <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5" Foreground="Gray"/>
            <TextBox x:Name="LoginBox" Height="28" VerticalContentAlignment="Center"/>

            <TextBlock Text="Никнейм:" Margin="0,0,0,5" Foreground="Gray"/>
            <TextBox x:Name="NameBox" Height="28" VerticalContentAlignment="Center"/>

            <TextBlock Text="Email:" Margin="0,0,0,5" Foreground="Gray"/>
            <TextBox x:Name="EmailBox" Height="28" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="Gray"/>
            <PasswordBox x:Name="PasswordBox" Height="28" VerticalContentAlignment="Center"/>

            <TextBlock Text="Повторите пароль:" Margin="0,0,0,5" Foreground="Gray"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="28" VerticalContentAlignment="Center"/>

            <Button Content="Создать аккаунт" Click="Register_Click" Height="35" Margin="0,15,0,0"/>

            <Button Content="Назад к авторизации" Click="Back_Click" Margin="0,15,0,0"  HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>