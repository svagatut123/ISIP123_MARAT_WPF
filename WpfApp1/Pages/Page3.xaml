<Page x:Class="WpfApp1.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сохранение сборки">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Сохранение новой сборки" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Название сборки:" Margin="0,0,0,5"/>
            <TextBox x:Name="BuildNameBox" Margin="0,0,0,15"/>

            <TextBlock Text="Автор сборки:" Margin="0,0,0,5"/>
            <TextBox x:Name="AuthorBox" Margin="0,0,0,20"/>

            <Button Content="Сохранить в БД" Click="Save_Click" Padding="10"/>
            <Button Content="Отмена" Click="Cancel_Click" Padding="10" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>