<Page x:Class="WpfApp1.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сборки">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="AssembliesGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="ShowDetails">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding author}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1" Content="Назад" Click="BackClick" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Page>