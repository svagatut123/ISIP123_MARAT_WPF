<Page x:Class="WpfApp1.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="Детали книги">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">

                <TextBlock x:Name="TitleTxt" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Text="Название книги"/>
                <TextBlock x:Name="AuthorTxt" FontSize="18" Foreground="Gray" Margin="0,5,0,15" Text="Автор: Имя автора"/>

                <TextBlock Text="Описание:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock x:Name="DescTxt" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20" Text="Здесь будет описание книги..."/>

                <TextBlock Text="Текст произведения:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                    <TextBox x:Name="ContentTxt" Height="300" IsReadOnly="True" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10" 
                             FontSize="14" Background="#FAFAFA"/>
                </Border>

                <UniformGrid Columns="2" Margin="0,20">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Добавить в список:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusSelectCombo" Height="30">
                            <ComboBoxItem Content="В планах" IsSelected="True"/>
                            <ComboBoxItem Content="Читаю"/>
                            <ComboBoxItem Content="Прочитано"/>
                            <ComboBoxItem Content="Заброшено"/>
                        </ComboBox>
                        <Button Content="Сохранить в список" Click="AddToList_Click" Margin="0,10,0,0" Height="35" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Пожаловаться:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComplaintReasonCombo" Height="30">
                            <ComboBoxItem Content="Оскорбления"/>
                            <ComboBoxItem Content="Плагиат"/>
                            <ComboBoxItem Content="Спойлеры"/>
                            <ComboBoxItem Content="Другое"/>
                        </ComboBox>
                        <Button Content="Отправить жалобу" Click="Report_Click" Margin="0,10,0,0" Height="35" Background="#FFFFEBEB" Cursor="Hand"/>
                    </StackPanel>
                </UniformGrid>

                <Separator Margin="0,10"/>

                <TextBlock Text="Отзывы читателей" FontSize="20" FontWeight="Bold" Margin="0,10"/>

                <Border Background="#F9F9F9" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Оставить свой отзыв:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox x:Name="ReviewTextBox" Height="80" TextWrapping="Wrap" Margin="0,0,0,10" 
                                 Padding="5" AcceptsReturn="True"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ваша оценка (1-5):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="RatingCombo" Width="60" Height="30">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5" IsSelected="True"/>
                            </ComboBox>
                            <Button Content="Опубликовать отзыв" Click="SendReview_Click" 
                                    Margin="20,0,0,0" Padding="20,0" Height="30" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="ReviewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Users.DisplayName}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14"/>
                                    <TextBlock Grid.Row="1" Text="{Binding ReviewText}" TextWrapping="Wrap" Margin="0,5,0,5" FontSize="13"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="Оценка системы: " FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Rating}" FontSize="12" FontWeight="Bold" Foreground="OrangeRed"/>
                                        <TextBlock Text="/10" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>