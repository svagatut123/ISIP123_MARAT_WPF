<Page x:Class="WpfApp1.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="информация о книге">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleTxt" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="AuthorTxt" FontSize="16" Foreground="Gray" Margin="0,5"/>
            <TextBlock x:Name="DescTxt" TextWrapping="Wrap" Margin="0,10"/>

            <Separator Margin="0,10"/>

            <TextBlock Text="текст книги:" FontWeight="Bold"/>
            <TextBox x:Name="ContentTxt" IsReadOnly="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" Margin="0,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="выберите список: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="StatusSelectCombo" Width="120" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBoxItem Content="В планах" IsSelected="True"/>
                    <ComboBoxItem Content="Читаю"/>
                    <ComboBoxItem Content="Прочитано"/>
                    <ComboBoxItem Content="Заброшено"/>
                </ComboBox>

                <Button Content="добавить в список" Click="AddToList_Click" Width="150" Margin="0,0,10,0"/>
                <Button Content="пожаловаться" Click="Report_Click" Background="LightCoral"/>
            </StackPanel>

            <TextBlock Text="отзывы:" FontSize="18" Margin="0,20,0,10"/>
            <ItemsControl x:Name="ReviewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Users.DisplayName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Rating, StringFormat='оценка: {0}/5'}" Foreground="Orange"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>