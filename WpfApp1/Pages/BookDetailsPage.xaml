<Page x:Class="WpfApp1.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="Детали книги">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">

                <TextBlock x:Name="TitleTxt" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Text="Название книги"/>

                <WrapPanel Margin="0,5,0,15" VerticalAlignment="Center">
                    <TextBlock x:Name="AuthorTxt" FontSize="18" Foreground="Gray" Text="Автор: Имя автора" VerticalAlignment="Center"/>
                    <Button x:Name="ReportAuthorBtn" Content="⚠️ Пожаловаться на автора" Click="ReportAuthor_Click" 
                            Margin="15,0,0,0" Padding="8,2" Background="#FFF5F5F5" BorderBrush="LightGray" 
                            FontSize="12" Cursor="Hand" VerticalAlignment="Center"/>
                    <Button x:Name="FreezeBookBtn" Content="❄️ Заморозить книгу" Click="FreezeBook_Click" 
                            Margin="15,0,0,0" Width="150" Height="35" Background="#FFEBF5FF" 
                            BorderBrush="#FFA3C2FF" Cursor="Hand" Loaded="AdminElement_Loaded"/>
                </WrapPanel>

                <TextBlock Text="Описание:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock x:Name="DescTxt" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20" Text="Здесь будет описание книги..."/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBlock Text="Жанр: " FontWeight="Bold" Foreground="Gray" FontSize="14"/>
                    <TextBlock x:Name="BookGenreTxt" Text="Не указан" Foreground="#2C3E50" FontSize="14"/>
                </StackPanel>

                <TextBlock Text="Текст произведения:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                    <TextBox x:Name="ContentTxt" Height="300" IsReadOnly="True" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10" 
                             FontSize="14" Background="#FAFAFA"/>
                </Border>

                <Grid Margin="0,20">
                    <StackPanel>
                        <TextBlock Text="Управление и действия:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <ComboBox x:Name="StatusSelectCombo" Height="35" Width="150" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="В планах" IsSelected="True"/>
                                <ComboBoxItem Content="Читаю"/>
                                <ComboBoxItem Content="Прочитано"/>
                                <ComboBoxItem Content="Заброшено"/>
                            </ComboBox>

                            <Button Content="Сохранить в список" Click="AddToList_Click" 
                                    Margin="10,0,0,0" Width="160" Height="35" Cursor="Hand"/>

                            <Button x:Name="ReportBookBtn" Content="Пожаловаться на книгу" Click="ReportBook_Click" 
                                    Margin="15,0,0,0" Width="180" Height="35" Background="#FFFFEBEB" 
                                    BorderBrush="#FFA3A3" Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,10"/>

                <TextBlock Text="Отзывы читателей" FontSize="20" FontWeight="Bold" Margin="0,10"/>

                <Border x:Name="AddReviewBlock" Background="#F9F9F9" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Оставить свой отзыв:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox x:Name="ReviewTextBox" Height="80" TextWrapping="Wrap" Margin="0,0,0,10" 
                                 Padding="5" AcceptsReturn="True"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ваша оценка (1-5):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="RatingCombo" Width="60" Height="30">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5" IsSelected="True"/>
                            </ComboBox>
                            <Button Content="Опубликовать отзыв" Click="SendReview_Click" 
                                    Margin="20,0,0,0" Padding="20,0" Height="30" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="ReviewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Users.DisplayName}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReviewText}" TextWrapping="Wrap" Margin="0,5,0,5" FontSize="13"/>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Оценка пользователя: " FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Rating}" FontSize="12" FontWeight="Bold" Foreground="OrangeRed"/>
                                        <TextBlock Text=" / 5" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🚩 Пожаловаться" Click="ReportReview_Click" Tag="{Binding ReviewId}" Margin="5,0" Padding="5,2" FontSize="11" Cursor="Hand"/>
                                        <Button x:Name="FreezeReviewBtn" Content="❄️ Заморозить" Click="FreezeReview_Click" Tag="{Binding ReviewId}" 
                                Padding="5,2" FontSize="11" Background="#FFEBF5FF" BorderBrush="#FFA3C2FF" Cursor="Hand"
                                Loaded="AdminElement_Loaded"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>