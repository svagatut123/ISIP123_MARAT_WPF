<Page x:Class="WpfApp1.Pages.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выбор места">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock x:Name="MovieTitleText" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="SessionInfoText"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SeatsList" Margin="10" Width="600">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Seats_number}" 
                                Width="50" 
                                Height="50" 
                                Margin="2"
                                Click="SeatButton_Click"
                                Tag="{Binding Seats_id}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Очистить выбор" Click="ClearSelection_Click" Margin="5" Width="120"/>
            <Button Content="Оформить билет" Click="BookTicket_Click" Margin="5" Width="120"/>
        </StackPanel>
    </Grid>
</Page>