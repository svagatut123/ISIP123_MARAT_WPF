<Page x:Class="WpfApp1.Pages.AddBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="добавление книги">
    <StackPanel Margin="20" MaxWidth="400" HorizontalAlignment="Left">
        <TextBlock Text="название книги:"/>
        <TextBox x:Name="TitleBox" Margin="0,5,0,10"/>

        <TextBlock Text="описание:"/>
        <TextBox x:Name="DescBox" Height="100" TextWrapping="Wrap" Margin="0,5,0,10"/>

        <TextBlock Text="текст книги:"/>
        <TextBox x:Name="ContentBox" Height="200" TextWrapping="Wrap" Margin="0,5,0,10"/>

        <TextBlock Text="жанр книги:" Margin="0,5,0,0"/>
        <ComboBox x:Name="GenreCombo" DisplayMemberPath="Name" Margin="0,5,0,10" Height="25"/>
        
        <Button Content="опубликовать" Click="SaveBook_Click" Height="30"/>
    </StackPanel>
</Page>