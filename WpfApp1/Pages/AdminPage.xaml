<Page x:Class="WpfApp1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Пользователи">
                <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="130" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="Текущая роль" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoleText}" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Изменить роль" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding RoleText, Mode=OneWay}" 
                                              SelectionChanged="RoleCombo_SelectionChanged" 
                                              Tag="{Binding UserId}"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Пользователь"/>
                                        <ComboBoxItem Content="Автор"/>
                                        <ComboBoxItem Content="Администратор"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Изменить пароль" Click="ChangePassword_Click" Tag="{Binding UserId}" Width="120" HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Жалобы и Заморозки">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ComplaintsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип объекта" Binding="{Binding TargetType}" Width="120"/>
                            <DataGridTextColumn Header="ID Объекта" Binding="{Binding TargetId}" Width="100"/>
                            <DataGridTextColumn Header="Причина / Текст жалобы" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" Content="✅ Одобрить апелляцию (Разморозить книгу)" 
                            Click="UnfreezeBook_Click" Height="35" Margin="0,10,0,0" Background="#E6F4EA"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>