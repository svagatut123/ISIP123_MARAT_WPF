<Page x:Class="WpfApp1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="админка">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="жалобы">
                <DataGrid x:Name="ComplaintsGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="кто" Binding="{Binding Users.DisplayName}" Width="100"/>
                        <DataGridTextColumn Header="тип цели" Binding="{Binding TargetType}" Width="100"/>
                        <DataGridTextColumn Header="причина" Binding="{Binding Reason}" Width="*"/>
                        <DataGridTemplateColumn Header="действия">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="удалить жалобу" Click="DeleteComplaint_Click" Tag="{Binding ComplaintId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="заявки на авторов">
                <DataGrid x:Name="AuthorRequestsGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="пользователь" Binding="{Binding Users.Login}"/>
                        <DataGridTextColumn Header="дата" Binding="{Binding RequestDate}"/>
                        <DataGridTemplateColumn Header="решение">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✅" Click="AcceptAuthor_Click" Tag="{Binding RequestId}" Margin="2"/>
                                        <Button Content="❌" Click="DeclineAuthor_Click" Tag="{Binding RequestId}" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="пользователи">
                <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="логин" Binding="{Binding Login}"/>

                        <DataGridTextColumn Header="роль" Binding="{Binding Roles.RoleName}"/>

                        <DataGridCheckBoxColumn Header="заморожен" Binding="{Binding IsFrozen}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>