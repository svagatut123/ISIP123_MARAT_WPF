<Page x:Class="WpfApp1.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="страница автора">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="мои публикации" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="добавить новую книгу" Click="AddBookButton_Click" Margin="20,0,0,0" Padding="10,5"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="опубликованные">
                <DataGrid x:Name="ActiveBooksGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="название" Binding="{Binding Title}" Width="200"/>
                        <DataGridTextColumn Header="жанр" Binding="{Binding Genres.Name}" Width="100"/>
                        <DataGridTextColumn Header="рейтинг" Binding="{Binding Rating}" Width="60"/>
                        <DataGridTemplateColumn Header="действия">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="редактировать" Click="EditBook_Click" Tag="{Binding BookId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="замороженные">
                <DataGrid x:Name="FrozenBooksGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#FFF3F3F3">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="название" Binding="{Binding Title}" Width="200"/>
                        <DataGridTextColumn Header="причина заморозки" Binding="{Binding FreezeReason}" Width="*"/>
                        <DataGridTemplateColumn Header="действия">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="оспорить" Click="Appeal_Click" Tag="{Binding BookId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>