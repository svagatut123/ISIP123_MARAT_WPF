<Page x:Class="WpfApp1.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет автора">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="📚 Мои опубликованные книги:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid x:Name="ActiveBooksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название книги" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding GenresText}" Width="150"/>

                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏️ Изменить" Click="EditBook_Click" Tag="{Binding BookId}" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock Text="❄️ Замороженные произведения:" FontSize="16" FontWeight="Bold" Margin="0,0,0,5" Foreground="DarkRed"/>
                <DataGrid x:Name="FrozenBooksGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="180" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название книги" Binding="{Binding Title}" Width="*"/>

                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔥 Оспорить бан" Click="Appeal_Click" Tag="{Binding BookId}" Cursor="Hand" Background="#FFFFEBEB"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="12">
                <Grid>
                    <TextBlock x:Name="PlaceholderTxt" Text="Выберите книгу для редактирования в таблице выше." 
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>

                    <StackPanel x:Name="EditBlock" Visibility="Collapsed">
                        <TextBlock Text="Редактирование произведения" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Название:" Margin="0,0,0,3"/>
                        <TextBox x:Name="EditTitleBox" Margin="0,0,0,10" Height="25" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Жанр публикации:" Margin="0,0,0,3"/>
                        <ComboBox x:Name="EditGenreCombo" Margin="0,0,0,10" Height="25"/>

                        <TextBlock Text="Текст книги:"/>
                        <TextBox x:Name="EditContentBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto"/>

                        <Button Content="💾 Сохранить изменения" Click="SaveChanges_Click" Height="30" Background="#E2F0D9" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>