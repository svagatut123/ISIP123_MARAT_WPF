<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="профиль пользователя">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="информация о пользователе" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="NameTextBlock" Margin="0,0,0,5"/>
            <TextBlock x:Name="LoginTextBlock" Margin="0,0,0,5"/>
            <TextBlock x:Name="EmailTextBlock" Margin="0,0,0,5"/>

            <Button Content="подать заявку на роль автора" Click="ApplyAuthorButton_Click" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="мои отзывы" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="ReviewsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="дата" Binding="{Binding ReviewDate, StringFormat=d}"/>
                    <DataGridTextColumn Header="книга" Binding="{Binding Books.Title}"/>
                    <DataGridTextColumn Header="оценка" Binding="{Binding Rating}"/>
                    <DataGridTextColumn Header="текст" Binding="{Binding ReviewText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>