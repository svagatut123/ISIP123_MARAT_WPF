<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="Профиль" FontSize="18" Margin="0,0,0,10"/>
        <TextBlock x:Name="TxtName" Margin="0,0,0,5"/>
        <TextBlock x:Name="TxtLogin" Margin="0,0,0,5"/>
        <TextBlock x:Name="TxtEmail" Margin="0,0,0,5"/>
        <TextBlock x:Name="TxtRole" Margin="0,0,0,10"/>
        <Button Content="Получить роль Автора" Click="BtnRequestAuthor_Click" Margin="0,0,0,10"/>
        <TextBlock Text="Мои отзывы:" Margin="0,0,0,5"/>
        <DataGrid x:Name="GridMyReviews" AutoGenerateColumns="True" />
        <Button Content="Выйти" Click="BtnLogout_Click" Margin="0,10,0,0"/>
    </StackPanel>
</Page>