<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Личный кабинет" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <WrapPanel Margin="0,5">
                <TextBlock Text="Имя пользователя: "/>
                <TextBlock x:Name="NameText" FontWeight="Bold"/>
            </WrapPanel>

            <WrapPanel Margin="0,5">
                <TextBlock Text="Логин: "/>
                <TextBlock x:Name="LoginText"/>
            </WrapPanel>

            <WrapPanel Margin="0,5">
                <TextBlock Text="Email: "/>
                <TextBlock x:Name="EmailText"/>
            </WrapPanel>

            <WrapPanel Margin="0,5">
                <TextBlock Text="Роль в системе: "/>
                <TextBlock x:Name="RoleText" FontWeight="Bold"/>
            </WrapPanel>

            <StackPanel x:Name="FrozenPanel" Visibility="Collapsed" Margin="0,20,0,0">
                <Image Source="/Images/warning.png" Width="40" Height="40" HorizontalAlignment="Left"/>
                <TextBlock Text="Внимание! Этот аккаунт заморожен администрацией." Foreground="Red" FontWeight="Bold"/>
                <WrapPanel Margin="0,5">
                    <TextBlock Text="Официальная причина: "/>
                    <TextBlock x:Name="FreezeReasonText" Foreground="Red"/>
                </WrapPanel>
                <Button Content="Подать заявку на разморозку" Click="AppealUser_Click" Width="200" Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>