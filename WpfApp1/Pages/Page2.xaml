<Page x:Class="WpfApp1.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сохранение">
    <Grid Margin="50">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Название сборки" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Width="300" Margin="0,0,0,20"/>
            <TextBlock Text="Автор" Margin="0,0,0,5"/>
            <TextBox x:Name="AuthorBox" Width="300" Margin="0,0,0,20"/>
            <Button Content="Сохранить" Click="SaveClick" Width="150"/>
            <Button Content="Отмена" Click="CancelClick" Width="150" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>