<Page x:Class="WpfApp1.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Товары">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                   Text="Каталог товаров" 
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,15"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListProducts">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="180"
                                   ItemHeight="280"
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="170" Height="270" Margin="5">
                            <Image Source="{Binding IzobrazhenieTovara}" 
                                   Width="150" Height="150" 
                                   Stretch="Uniform" 
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NazvanieTovara}" 
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center" 
                                       Margin="0,5"/>
                            <TextBlock Text="{Binding Cena, StringFormat={}{0:##0.00} руб}" 
                                       TextAlignment="Center" 
                                       Margin="0,3"/>
                            <Button Content="Добавить в корзину" 
                                    Tag="{Binding}" 
                                    Click="AddToCart_Click" 
                                    Margin="0,5"
                                    Padding="4,2"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>