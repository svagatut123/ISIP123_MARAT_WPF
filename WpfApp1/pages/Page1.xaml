<Page x:Class="WpfApp1.pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 1">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Выберите модель и двигатель"/>

            <TextBlock Text="Модель автомобиля:" />
            <ComboBox x:Name="CmbModel" DisplayMemberPath="Name" 
                      SelectionChanged="CmbModel_SelectionChanged" 
                      Height="30" Width="300"/>

            <!-- Двигатель -->
            <TextBlock Text="Тип двигателя:" Margin="0,20,0,0"/>
            <ComboBox x:Name="CmbEngine" DisplayMemberPath="Type" 
                      SelectionChanged="CmbEngine_SelectionChanged" 
                      Height="30" Width="300"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
                <Button Content="Далее" Click="BtnNext_Click" 
                        x:Name="BtnNext" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>