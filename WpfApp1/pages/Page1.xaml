<Page x:Class="WpfApp1.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товары">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Каталог товаров" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,15" HorizontalAlignment="Center" Grid.Row="0"/>

        <ListView x:Name="ListProducts" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Изображение" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding IzobrazhenieTovara}" 
                                       Width="80" Height="80" Stretch="Uniform"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Название" Width="200" 
                                    DisplayMemberBinding="{Binding NazvanieTovara}"/>
                    <GridViewColumn Header="Цена" Width="120" 
                                    DisplayMemberBinding="{Binding Cena, StringFormat={}{0:#,##0.00} ₽}"/>
                    <GridViewColumn Header="Действие" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Добавить в корзину" 
                                        Tag="{Binding}" 
                                        Click="AddToCart_Click"
                                        Padding="8,4"
                                        Background="#FF2196F3"
                                        Foreground="White"
                                        BorderThickness="0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>