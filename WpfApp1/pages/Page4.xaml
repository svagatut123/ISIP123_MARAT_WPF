<Page x:Class="WpfApp1.pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 4"
      Loaded="stranica_Zagruzena"
      Unloaded="stranica_Vigruzhena">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Контактные данные" 
                   FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,30"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="500">
                <!-- фио -->
                <TextBlock Text="ФИО:" 
                           FontSize="14" Margin="0,0,0,10"/>
                <TextBox x:Name="poleFio" Height="35" Padding="10" 
                         FontSize="14" TextChanged="pole_Izmenilos"/>
                <TextBlock x:Name="oshibkaFio" Foreground="Red" 
                           FontSize="12" Visibility="Collapsed"/>

                <!-- телефон -->
                <TextBlock Text="Номер телефона:" 
                           FontSize="14" Margin="0,20,0,10"/>
                <TextBox x:Name="poleTel" Height="35" Padding="10" 
                         FontSize="14" TextChanged="pole_Izmenilos"/>
                <TextBlock x:Name="oshibkaTel" Foreground="Red" 
                           FontSize="12" Visibility="Collapsed"/>

                <!-- email -->
                <TextBlock Text="Email:" 
                           FontSize="14" Margin="0,20,0,10"/>
                <TextBox x:Name="poleEmail" Height="35" Padding="10" 
                         FontSize="14" TextChanged="pole_Izmenilos"/>
                <TextBlock x:Name="oshibkaEmail" Foreground="Red" 
                           FontSize="12" Visibility="Collapsed"/>

                <!-- информация -->
                <Border Background="#F8F9FA" Padding="15" CornerRadius="8" Margin="0,40,0,0">
                    <TextBlock x:Name="info" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- навигация -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Content="Назад" Click="nazad_Click" 
                    Background="#95A5A6" Foreground="White"
                    Padding="20,10" Margin="0,0,10,0"/>
            <Button Content="К сводке" Click="dalee_Click" 
                    Background="#3498DB" Foreground="White"
                    Padding="20,10" FontWeight="Bold"
                    x:Name="knopkaDalee" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>