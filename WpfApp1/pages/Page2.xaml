<Page x:Class="WpfApp1.pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 2">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите цвет и опции" 
                   FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Цвет кузова:" 
                       FontSize="14" Margin="0,0,0,10"/>
            <ComboBox x:Name="spisokCvet" DisplayMemberPath="nazvanie" 
                      SelectionChanged="cvet_Selected"
                      Height="35" Width="400" />

            <TextBlock Text="Дополнительные опции:" 
                       FontSize="14" Margin="0,30,0,10"/>

            <StackPanel x:Name="panelOpcii" Margin="0,0,0,30">
          
            </StackPanel>

            <Border Background="#F5FFFA" Padding="15" CornerRadius="8">
                <TextBlock x:Name="tekyshayaCena" FontSize="16" FontWeight="Bold" 
                           TextAlignment="Center" Foreground="#27AE60"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Content="Назад" Click="nazad_Click" 
                    Background="#95A5A6" Foreground="White"
                    Padding="20,10" Margin="0,0,10,0"/>
            <Button Content="Далее" Click="dalee_Click" 
                    Background="#3498DB" Foreground="White"
                    Padding="20,10" FontWeight="Bold"
                    x:Name="knopkaDalee" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>