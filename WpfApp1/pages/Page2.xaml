<Page x:Class="WpfApp1.pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите цвет и опции"/>

        <StackPanel Grid.Row="1">
            <!-- Цвет -->
            <TextBlock Text="Цвет кузова:"/>
            <ComboBox x:Name="CmbColor" DisplayMemberPath="Name" 
                      SelectionChanged="CmbColor_SelectionChanged" 
                      Height="30" Width="300"/>

            <!-- Опции -->
            <TextBlock Text="Дополнительные опции:" Margin="0,20,0,0"/>
            <ItemsControl x:Name="OptionsList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Width="200"/>
                                <TextBlock Text="{Binding Price, StringFormat={}+ {0:N0} руб.}" 
                                           Foreground="Gray"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Текущая цена -->
            <TextBlock x:Name="TxtPrice" FontSize="16" FontWeight="Bold" Foreground="#27AE60"/>
        </StackPanel>

        <!-- Навигация -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад" Click="BtnBack_Click" />
            <Button Content="Далее" Click="BtnNext_Click" 
                    x:Name="BtnNext" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>