<Page x:Class="WpfApp1.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ваша корзина" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <ListView x:Name="CartItemsList" Grid.Row="1" Margin="0,0,0,15">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="250" DisplayMemberBinding="{Binding Product.NazvanieTovara}"/>
                    <GridViewColumn Header="Цена" Width="120" DisplayMemberBinding="{Binding Product.Cena, StringFormat='{}{0:#,##0.00} ₽'}"/>
                    <GridViewColumn Header="Количество" Width="100" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Сумма" Width="120" DisplayMemberBinding="{Binding Total, StringFormat='{}{0:#,##0.00} ₽'}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <Button Content="Оформить заказ" Click="Checkout_Click" Padding="15,8" Background="#FF4CAF50" Foreground="White" FontSize="14"/>
        </StackPanel>
    </Grid>
</Page>