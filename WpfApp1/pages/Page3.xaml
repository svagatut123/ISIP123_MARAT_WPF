<Page x:Class="WpfApp1.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оформление заказа">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление заказа" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ФИО:" Grid.Row="0" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox x:Name="FioBox" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" Padding="5"/>

            <TextBlock Text="Email:" Grid.Row="1" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox x:Name="EmailBox" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" Padding="5"/>

            <TextBlock Text="Адрес доставки:" Grid.Row="2" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" Padding="5"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Товары в заказе:" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
            <TextBlock x:Name="TotalOrderText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
        </StackPanel>

        <ListView x:Name="OrderItemsList" Grid.Row="3" Margin="0,0,0,15" Height="200">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="250" DisplayMemberBinding="{Binding Product.NazvanieTovara}"/>
                    <GridViewColumn Header="Цена" Width="120" DisplayMemberBinding="{Binding Product.Cena, StringFormat='{}{0:#,##0.00} ₽'}"/>
                    <GridViewColumn Header="Количество" Width="100" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Сумма" Width="120" DisplayMemberBinding="{Binding Total, StringFormat='{}{0:#,##0.00} ₽'}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="Cancel_Click" Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="Заказать" Click="PlaceOrder_Click" Padding="15,8" Background="#FF4CAF50" Foreground="White" FontSize="14"/>
        </StackPanel>
    </Grid>
</Page>