<Page x:Class="WpfApp1.pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 3"
       Loaded="Page3_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Расчет кредита" 
                   FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,30"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="600">
                <!-- общая цена -->
                <Border Background="#ECF0F1" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                    <TextBlock x:Name="cenaItog" FontSize="16" FontWeight="Bold"/>
                </Border>

                <!-- первый взнос -->
                <TextBlock Text="Первоначальный взнос (%):" 
                           FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Slider x:Name="sliderProcent" Minimum="10" Maximum="90" Value="20"
                            Width="300" Margin="0,0,20,0"
                            ValueChanged="slider_Changed"/>
                    <TextBlock x:Name="textProcent" Text="20%" 
                               FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="summaVznos" Margin="0,0,0,30"/>

                <!-- срок -->
                <TextBlock Text="Срок кредита (месяцев):" 
                           FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Slider x:Name="sliderSrok" Minimum="12" Maximum="96" Value="24"
                            Width="300" Margin="0,0,20,0"
                            ValueChanged="slider_Changed"/>
                    <TextBlock x:Name="textSrok" Text="24 мес." 
                               FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <!-- расчет -->
                <Border Background="#F8F9FA" Padding="15" CornerRadius="8" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Расчет кредита:" 
                                   FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Сумма кредита:" 
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="summaCredit" 
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ставка годовая:" 
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="15%" 
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Общая переплата:" 
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="pereplata" 
                                       FontWeight="Bold"/>

                            <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Margin="0,15"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ежемесячный платеж:" 
                                       FontWeight="Bold" FontSize="16"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="platejMes" 
                                       FontWeight="Bold" FontSize="16" Foreground="#27AE60"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- навигация -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Content="Назад" Click="nazad_Click" 
                    Background="#95A5A6" Foreground="White"
                    Padding="20,10" Margin="0,0,10,0"/>
            <Button Content="Далее" Click="dalee_Click" 
                    Background="#3498DB" Foreground="White"
                    Padding="20,10" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>