<Page x:Class="WpfApp1.pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page3"
      Loaded="Page_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 3: Расчет Кредита" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Первоначальный взнос (%):" Margin="0,10,0,5"/>
            <Slider x:Name="SliderPayment" Minimum="10" Maximum="90" Value="20"
                    TickFrequency="10" IsSnapToTickEnabled="True"
                    ValueChanged="OnSliderChanged" Width="400" HorizontalAlignment="Left"/>

            <TextBlock x:Name="TxtInitialPayment" Text="20%" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Срок кредита (мес.):" Margin="0,10,0,5"/>
            <Slider x:Name="SliderTerm" Minimum="12" Maximum="96" Value="24"
                    TickFrequency="12" IsSnapToTickEnabled="True"
                    ValueChanged="OnSliderChanged" Width="400" HorizontalAlignment="Left"/>

            <TextBlock x:Name="TxtLoanTerm" Text="24 мес." FontWeight="Bold" Margin="0,0,0,20"/>

            <Separator Margin="0,10"/>

            <TextBlock x:Name="TxtTotalPrice" Text="Цена авто: 0 руб." FontSize="16"/>
            <TextBlock x:Name="TxtMonthlyPayment" Text="Ежемесячный платеж: 0 руб." 
                       FontSize="18" FontWeight="Bold" Foreground="Green" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Назад" Click="BtnBack_Click" Margin="0,0,10,0" Padding="15,5"/>
            <Button Content="Далее" Click="BtnNext_Click" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Page>