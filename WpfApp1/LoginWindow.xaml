<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="вход в систему" Height="350" Width="300" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Margin="0,0,0,10" Height="25"/>

            <TextBlock Text="пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20" Height="25"/>

            <Button Content="войти" Click="LoginButton_Click" Margin="0,0,0,10" Height="30"/>
            <Button Content="Зарегистрироваться" Click="GoToRegister_Click" Margin="0,0,0,10" HorizontalAlignment="Center" Width="260" Height="30"/>
        </StackPanel>
        <Frame x:Name="MainFrame1" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>