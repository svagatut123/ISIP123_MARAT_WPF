<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="300" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Логин:" />
        <TextBox x:Name="TxtLogin" Margin="0,0,0,10" />
        <TextBlock Text="Пароль:" />
        <TextBox x:Name="TxtPassword" Margin="0,0,0,10" />
        <Button Content="Войти" Click="BtnLogin_Click" />
        <Button Content="Регистрация" Margin="0,5,0,0" Click="BtnRegister_Click" />
    </StackPanel>
</Window>