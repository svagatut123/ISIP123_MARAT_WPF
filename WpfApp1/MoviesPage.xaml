<Page x:Class="WpfApp1.MoviesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Фильмы">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchBox" Width="200" Height="30" Margin="5" 
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortBox" Width="150" Height="30" Margin="5" 
                      SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="По названию"/>
                <ComboBoxItem Content="По рейтингу"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MoviesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="180"
                                   ItemHeight="320"
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="170" Height="310" Margin="5">
                            <Image Source="{Binding PosterUrl}" 
                                   Width="150" Height="200" 
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" 
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center" 
                                       FontWeight="Bold"
                                       Margin="0,5"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}" 
                                       TextAlignment="Center" 
                                       Margin="0,2"/>
                            <TextBlock Text="{Binding StartDate, StringFormat=Начало: {0:d}}" 
                                       TextAlignment="Center" 
                                       Margin="0,2"/>
                            <TextBlock x:Name="AgeRatingText" 
                                       TextAlignment="Center" 
                                       Margin="0,2"/>
                            <Button Content="Подробнее" 
                                    Tag="{Binding MovieId}" 
                                    Click="MovieDetail_Click" 
                                    Margin="0,5"
                                    Padding="4,2"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>